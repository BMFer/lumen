1 + 2 * 3              => (add 1 (mul 2 3))                = 7
(1 + 2) * 3            => (mul (add 1 2) 3)                = 9
2 ^ 3 ^ 2              => (pow 2 (pow 3 2))                = 512
-2 ^ 2                 => (-(pow 2 2))                     = -4
2 ^ -1                 => (pow 2 (-1))                     = 0.5
sqrt(16) + abs(-2.5)   => (add sqrt(16) abs((-2.5)))       = 6.5
2 * pi * 10            => (mul (mul 2 pi) 10)              = 62.8319
